#pragma once

#include "rtx/pass/hair_test/hair_test_binding_indices.h"
#include "rtx/pass/common_bindings.slangh"

// Inputs

layout(binding = HAIR_TEST_BINDING_CONSTANTS)
ConstantBuffer<HairTestConstants> hairCb;

layout(binding = HAIR_TEST_BINDING_TLAS)
RaytracingAccelerationStructure hairTLAS;

// Linear Swept Sphere segment data in the RTXCR SDK's LSS list layout:
// two vertices per segment, positions tightly packed as xyzxyz... and radii as rrr...
// The same buffers feed the LSS BLAS build, so shading and traversal always agree.
layout(binding = HAIR_TEST_BINDING_SEGMENT_POSITIONS_INPUT)
StructuredBuffer<float> HairSegmentPositions;

layout(binding = HAIR_TEST_BINDING_SEGMENT_RADII_INPUT)
StructuredBuffer<float> HairSegmentRadii;

layout(binding = HAIR_TEST_BINDING_DEPTH_INPUT)
Sampler2D<float> PrimaryDepth;

// Outputs

layout(binding = HAIR_TEST_BINDING_OUTPUT)
RWTexture2D<float4> HairOutput;
